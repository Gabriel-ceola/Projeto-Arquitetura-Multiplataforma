{
  "realm": "dentist",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 43200,
  "ssoSessionMaxLifespan": 43200,
  "roles": {
    "realm": [
      { "name": "dentist", "description": "Dentista dono de serviços" },
