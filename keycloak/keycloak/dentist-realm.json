      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5068/*",
        "https://localhost:7235/*",
        "http://localhost:3000/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "dentist-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dentist-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dentist-api",
      "name": "Dentist Service API",
