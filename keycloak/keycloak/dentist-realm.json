      "emailVerified": true,
      "firstName": "Dentista",
      "lastName": "Teste",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "123456", "temporary": false }
      ],
      "realmRoles": ["dentist"]
    }
  ]
