{
  "info": {
    "name": "Employee Service",
    "description": "Requisições do Employee-service (Odontologia Integrada).\n\nSuba o banco (`docker compose up -d`) e a API (`dotnet run`, porta 5070). As requisições podem ser executadas em ordem pelo Collection Runner: o cadastro salva o `employeeId` usado pelas seguintes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Cadastrar funcionário (CreateEmployee)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "Cadastra um funcionário. Gera um CPF aleatório a cada execução e salva o id retornado em {{employeeId}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Souza\",\n  \"cpf\": \"{{cpf}}\",\n  \"email\": \"maria.souza@clinica.com\",\n  \"phone\": \"(43) 99999-8888\",\n  \"role\": \"recepcionista\",\n  \"status\": \"ativo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// CPF aleatório (11 dígitos) para a collection poder ser executada várias vezes",
              "const cpf = Array.from({ length: 11 }, () => Math.floor(Math.random() * 10)).join('');",
              "pm.collectionVariables.set('cpf', cpf);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('employeeId', body.id);",
              "pm.test('Telefone normalizado só com dígitos', () => pm.expect(body.phone).to.eql('43999998888'));",
              "pm.test('Header Location aponta para o funcionário', () => pm.expect(pm.response.headers.get('Location')).to.include(body.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Listar funcionários (GetEmployees)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "Lista todos os funcionários da clínica, ordenados por nome."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Lista contém o funcionário cadastrado', () => {",
              "  const ids = pm.response.json().map(e => e.id);",
              "  pm.expect(ids).to.include(pm.collectionVariables.get('employeeId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Buscar funcionário por Id (GetEmployeeById)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": "Busca os dados de um funcionário específico."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Retorna o funcionário certo', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('employeeId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Editar funcionário (EditEmployee)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": "Edita nome, e-mail, telefone, cargo e status. O CPF não pode ser alterado.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Souza Lima\",\n  \"email\": \"maria.lima@clinica.com\",\n  \"phone\": \"43999998888\",\n  \"role\": \"administrativo\",\n  \"status\": \"ferias\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Dados atualizados', () => {",
              "  pm.expect(body.name).to.eql('Maria Souza Lima');",
              "  pm.expect(body.role).to.eql('administrativo');",
              "  pm.expect(body.status).to.eql('ferias');",
              "});",
              "pm.test('CPF preservado', () => pm.expect(body.cpf).to.eql(pm.collectionVariables.get('cpf')));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Cadastrar com CPF duplicado (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "Tenta cadastrar outro funcionário com o mesmo CPF. Deve retornar 409 Conflict.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"João Lima\",\n  \"cpf\": \"{{cpf}}\",\n  \"email\": \"joao.lima@clinica.com\",\n  \"phone\": \"4333334444\",\n  \"role\": \"auxiliar\",\n  \"status\": \"ativo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('Mensagem cita o CPF', () => pm.expect(pm.response.json().message).to.include('CPF'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Cadastrar com dados inválidos (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "Envia nome curto, CPF incompleto, e-mail e telefone inválidos. Deve retornar 400 Bad Request.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Al\",\n  \"cpf\": \"123\",\n  \"email\": \"email-invalido\",\n  \"phone\": \"999\",\n  \"role\": \"recepcionista\",\n  \"status\": \"ativo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('Mensagem lista os erros de validação', () => pm.expect(pm.response.json().message).to.include('CPF'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Remover funcionário (RemoveEmployee)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": "Remove o funcionário da clínica."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Buscar funcionário removido (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": "Após a remoção, a busca deve retornar 404 Not Found."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5070"
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "cpf",
      "value": ""
    }
  ]
}
