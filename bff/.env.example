# Servidor
PORT=3000
NODE_ENV=development

# Keycloak
KEYCLOAK_ISSUER=https://auth.exemplo.com/realms/clinica
KEYCLOAK_JWKS_URI=https://auth.exemplo.com/realms/clinica/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=bff-clinica
KEYCLOAK_AUDIENCE=
KEYCLOAK_ROLES_SOURCE=realm
JWT_CLOCK_TOLERANCE_SECONDS=5
JWKS_CACHE_MAX_AGE_MS=600000
JWKS_COOLDOWN_MS=30000

# Downstream
DENTIST_SERVICE_BASE_URL=http://localhost:5068
EMPLOYEE_SERVICE_BASE_URL=http://localhost:5070
DOWNSTREAM_TIMEOUT_MS=5000

# HTTP
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
