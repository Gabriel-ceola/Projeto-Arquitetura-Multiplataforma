# Copie para .env para sobrescrever os padrões (todos os valores são opcionais).

# Mesma versão para todos os componentes do stack.
ELK_VERSION=8.17.4

# Heap das JVMs (Elasticsearch e Logstash).
ES_JAVA_OPTS=-Xms1g -Xmx1g
LS_JAVA_OPTS=-Xms512m -Xmx512m

# Portas publicadas no host.
ES_PORT=9200
KIBANA_PORT=5601

# Pasta (relativa a elk/) onde os serviços gravam os logs JSON.
LOGS_DIR=../logs
